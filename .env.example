# Copy to .env (gitignored). Fill in the relevant section based on your data source.
# DATA_SOURCE controls which provider is used (default: auto).
#   "auto"         - DEFAULT. Uses Dhan when token is present, else NSE backup.
#   "dhan"         - Dhan broker API (NIFTY, BANKNIFTY, SENSEX); static token, no daily refresh.
#                    Provides real-time greeks (delta, gamma, theta, vega) and IV directly.
#   "nse"          - Legacy NSE scraper (NIFTY, BANKNIFTY only; no credentials needed).

DATA_SOURCE=auto

# --- CryptoCubera foundation -------------------------------------------------
# CRYPTO_CONFIG=config/crypto.yaml
# CRYPTO_DB_URL=sqlite:///./data/crypto/cubera.db
# CRYPTO_PORT=8760
# CRYPTO_FLAG_FEEDS_DERIBIT=0
# CRYPTO_LIVE_SPIKE_DERIBIT=0
# Market intelligence (intel.news flag on by default; mock fixtures without token)
# CRYPTOPANIC_TOKEN=
# CRYPTOPANIC_API_PLAN=developer
# CRYPTO_FLAG_INTEL_NEWS=1
# CRYPTO_FLAG_INTEL_CALENDAR=1
# Local Gemma 12B (Ollama-compatible). Off by default — language only, never creates GO.
# CRYPTO_FLAG_INTEL_GEMMA=1
# CRYPTO_GEMMA_BASE_URL=http://localhost:11434
# CRYPTO_GEMMA_MODEL=gemma2:12b
# CRYPTO_GEMMA_TIMEOUT_S=8
# DERIBIT_CLIENT_ID=

# --- CryptoCubera paper trading (demo/sim — default Confirm path) ------------
# Demo/testnet keys only: https://testnet.delta.exchange/ → API keys
# Without keys, Confirm uses local sim fills. Production trading URLs are refused.
# DELTA_PAPER_API_KEY=
# DELTA_PAPER_API_SECRET=
# DELTA_PAPER_REST_URL=https://cdn-ind.testnet.deltaex.org
# CRYPTO_FLAG_EXEC_PAPER=1
# CRYPTO_FLAG_EXEC_CONFIRM=1

# --- CryptoCubera Live Confirm (real capital — fail closed) ------------------
# Separate production India keys. Paper keys never unlock this path. No Auto.
# 1) Whitelist this host's static IP on the Delta India trading key
# 2) Set keys + exact ack strings below
# 3) CRYPTO_FLAG_EXEC_LIVE=1 CRYPTO_FLAG_EXEC_CONFIRM=1
# DELTA_LIVE_API_KEY=
# DELTA_LIVE_API_SECRET=
# DELTA_LIVE_REST_URL=https://api.india.delta.exchange
# CRYPTO_LIVE_CONFIRM_ACK=I_UNDERSTAND_LIVE_RISK
# DELTA_LIVE_IP_WHITELIST_ACK=1
# CRYPTO_FLAG_EXEC_LIVE=0
# CRYPTO_FLAG_EXEC_AUTO=0

# --- Dhan API credentials ---------------------------------------------------
# Required when DATA_SOURCE="dhan" or using Dhan feed under "auto".
# Generate at: https://dhanhq.co/docs/latest/authentication/
# The access token is static (no daily refresh required).
# Client ID is the numeric ID from your Dhan account.
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# --- NSE source (no credentials required; just run locally) ------------------
# NSE blocks datacenter/VPN IPs. Run from a home/Indian connection.
# NSE_DATA_SOURCE=nse   # kept for back-compat; use DATA_SOURCE above.

# --- LLM prose (optional; Ollama local default, Gemini optional) -------------
# Master off by default: unset CUBERA_LLM → zero LLM calls.
# CUBERA_LLM=1
# CUBERA_LLM_DIGEST=1
# CUBERA_LLM_ALERT_TAPE=1
# CUBERA_LLM_QA=1
# CUBERA_LLM_SESSION_READS=1
# CUBERA_LLM_COMMENTARY=1
# CUBERA_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma4:12b
# Optional cloud: CUBERA_LLM_PROVIDER=gemini + GEMINI_API_KEY=... (never commit)
# GEMINI_MODEL=gemini-3.8-flash
