# Copy to .env (gitignored). Fill in the relevant section based on your data source.
# DATA_SOURCE controls which provider is used (default: dhan).
#   "dhan"         - DEFAULT. Dhan broker API (NIFTY, BANKNIFTY); static token, no daily refresh.
#                    Provides real-time greeks (delta, gamma, theta, vega) and IV directly.
#   "icici_breeze" - ICICI Direct Breeze API (NIFTY, BANKNIFTY, SENSEX); session token refreshed daily.
#   "nse"          - Legacy NSE scraper (NIFTY, BANKNIFTY only; no credentials needed).

DATA_SOURCE=dhan

# --- Dhan API credentials ---------------------------------------------------
# Required when DATA_SOURCE="dhan".
# Generate at: https://dhanhq.co/docs/latest/authentication/
# The access token is static (no daily refresh required).
# Client ID is the numeric ID from your Dhan account.
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# --- ICICI Direct Breeze API credentials ------------------------------------
# Required when DATA_SOURCE="icici_breeze".
# Generate your session token daily at:
#   https://api.icicidirect.com/apiuser/login?api_key=<url-encoded-api-key>
# The session token expires at midnight IST — update ICICI_BREEZE_SESSION_TOKEN
# each trading day before running the app.
ICICI_BREEZE_API_KEY=your_api_key_here
ICICI_BREEZE_API_SECRET=your_secret_key_here
ICICI_BREEZE_SESSION_TOKEN=your_daily_session_token_here

# --- NSE source (no credentials required; just run locally) ------------------
# NSE blocks datacenter/VPN IPs. Run from a home/Indian connection.
# NSE_DATA_SOURCE=nse   # kept for back-compat; use DATA_SOURCE above.
